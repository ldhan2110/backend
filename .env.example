NODE_ENV=DEVELOPMENT
PORT=8080

# CORS allowed origins: "*" (all) or comma-separated list e.g. https://app.com,https://admin.app.com
CORS_ORIGIN=*

# Database configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_LOGGING=true

# Logging
LOG_LEVEL=info          # error | warn | info | debug (app logger)

# Auth — JWT secrets (required). Use long random strings in real environments.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m      # access token lifetime
JWT_REFRESH_TTL=7d      # refresh token lifetime

# Refresh-token store: REDIS_URL unset → in-memory (dev/single-instance only, wiped on restart)
# REDIS_URL=redis://localhost:6379

# Upload
UPLOAD_DIR=uploads