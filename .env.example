NODE_ENV=development
PORT=8080

# CORS allowed origins: "*" (all) or comma-separated list e.g. https://app.com,https://admin.app.com
CORS_ORIGIN=*

# Database configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_LOGGING=true

# Logging
LOG_LEVEL=info          # error | warn | info | debug (app logger)